<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from docs/app-icon.svg: three overlapping photo cards (the wallpaper set) behind a
     small refresh badge (the cycling). Coordinates are the SVG's own 512x512 canvas verbatim,
     so this file is the source of truth to re-derive from if that SVG ever changes. Drop
     shadows in the SVG have no VectorDrawable equivalent and are omitted. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- back-left card, rotated -14 degrees about the icon center -->
    <group android:pivotX="256" android:pivotY="256" android:rotation="-14">
        <path
            android:fillColor="#BFE0F2"
            android:pathData="M170,156 L272,156 A24,24 0 0 1 296,180 L296,352 A24,24 0 0 1 272,376 L170,376 A24,24 0 0 1 146,352 L146,180 A24,24 0 0 1 170,156 Z" />
    </group>

    <!-- back-right card, rotated +14 degrees about the icon center -->
    <group android:pivotX="256" android:pivotY="256" android:rotation="14">
        <path
            android:fillColor="#F6CFE0"
            android:pathData="M240,156 L342,156 A24,24 0 0 1 366,180 L366,352 A24,24 0 0 1 342,376 L240,376 A24,24 0 0 1 216,352 L216,180 A24,24 0 0 1 240,156 Z" />
    </group>

    <!-- center card -->
    <path android:pathData="M205,146 L307,146 A24,24 0 0 1 331,170 L331,342 A24,24 0 0 1 307,366 L205,366 A24,24 0 0 1 181,342 L181,170 A24,24 0 0 1 205,146 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="181"
                android:startY="146"
                android:endX="331"
                android:endY="366">
                <item android:offset="0" android:color="#FFF3E6" />
                <item android:offset="1" android:color="#FCE0CF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- sun + mountains, clipped to the center card's rounded-rect bounds -->
    <group>
        <clip-path android:pathData="M205,146 L307,146 A24,24 0 0 1 331,170 L331,342 A24,24 0 0 1 307,366 L205,366 A24,24 0 0 1 181,342 L181,170 A24,24 0 0 1 205,146 Z" />
        <path android:fillColor="#FFE9C7" android:pathData="M286,196 m-16,0 a16,16 0 1 0 32,0 a16,16 0 1 0 -32,0" />
        <path android:fillColor="#C9AEE0" android:pathData="M181,345 L228,288 L258,316 L288,278 L331,328 L331,366 L181,366 Z" />
        <path
            android:fillColor="#B79BD6"
            android:fillAlpha="0.85"
            android:pathData="M181,355 L212,322 L246,350 L331,352 L331,366 L181,366 Z" />
    </group>

    <!-- cycling badge - pulled in from the SVG's (390,390) r=52 to (330,330) r=44 (same 45deg
         diagonal from icon center, scaled proportionally) so its full extent sits inside the
         108dp adaptive-icon format's guaranteed-safe circle (r=~33dp, i.e. r=~156 on this
         512-unit canvas). At the original position/size it fell outside that circle and got
         cropped by a circular launcher mask - see docs/app-icon.svg's own comment for context. -->
    <path android:fillColor="#6E5A96" android:pathData="M330,330 m-44,0 a44,44 0 1 0 88,0 a44,44 0 1 0 -88,0" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M347.68,317.13 L347.68,326.78 L338.04,326.78" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M312.31,342.86 L312.31,333.21 L321.96,333.21" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M316.345,325.17 a14.47,14.47 0 0 1 23.88,-5.403 L347.68,326.78" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M343.65,334.82 a14.47,14.47 0 0 1 -23.88,5.403 L312.31,333.21" />
</vector>
